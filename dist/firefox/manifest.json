{
  "manifest_version": 3,
  "name": "PrepTip",
  "short_name": "PrepTip",
  "version": "0.1.2",
  "description": "Teacher-friendly tips and guided walkthroughs for the web tools you already use.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PrepTip",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/guide.js"
      ],
      "css": [
        "src/content/guide.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/youtube-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/youtube.js"
      ],
      "css": [
        "src/content/youtube.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html",
        "src/blocked/blocked.css",
        "src/blocked/blocked.js",
        "icons/icon-48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "incognito": "not_allowed",
  "sidebar_action": {
    "default_title": "PrepTip",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_panel": "src/sidepanel/sidepanel.html",
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "preptip@heberjones26.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "authenticationInfo"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  }
}
